<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Target: .NET Framework 4.8, which ships with Windows 10/11.
    The result is a single small VMGuard.exe that needs no runtime install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>VMGuard</AssemblyName>
    <RootNamespace>VMGuard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.1</Version>
    <ApplicationIcon>VMGuard.ico</ApplicationIcon>
    <AssemblyTitle>VMGuard</AssemblyTitle>
    <Company>VMGuard</Company>
    <Authors>VMGuard contributors</Authors>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RepositoryUrl>https://github.com/jcostasuarez/VMGuard</RepositoryUrl>
    <Deterministic>true</Deterministic>
    <Product>VMGuard</Product>
    <Description>Suspends VMware Workstation VMs on shutdown or low battery</Description>
    <Copyright>Copyright (c) 2026 VMGuard contributors</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Allows building outside Windows too (CI, Linux) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VMGuard.Tests" />
  </ItemGroup>

</Project>
