<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Target: .NET Framework 4.8, que ya viene con Windows 10/11.
    El resultado es un unico VMGuard.exe chico que no necesita instalar ningun runtime.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>VMGuard</AssemblyName>
    <RootNamespace>VMGuard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <Product>VMGuard</Product>
    <Description>Suspende las VMs de VMware Workstation al apagar o con bateria baja</Description>
    <Copyright>VMGuard</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Permite compilar tambien fuera de Windows (CI, Linux) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VMGuard.Tests" />
  </ItemGroup>

</Project>
